PORT=3000
# Samsara API token. Keep this ONLY on the server.
SAMSARA_API_TOKEN=
# Knox Manage OAuth credentials. Keep these ONLY on the server.
KNOX_REGION=ap01
KNOX_CLIENT_ID=
KNOX_CLIENT_SECRET=
KNOX_TENANT_ID=
# Optional: set true after adding valid credentials.
ENABLE_KNOX=true
ENABLE_SAMSARA=true
